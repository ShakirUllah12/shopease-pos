# ShopEase POS Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Examples:
# Local MongoDB: mongodb://127.0.0.1:27017/shopease_pos
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/shopease_pos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopease_pos

# If true or if local MongoDB is unavailable in development, an embedded in-memory MongoDB will be used
AUTO_FALLBACK_IN_MEMORY_DB=true

# Security
JWT_SECRET=shopease_jwt_secret_dev_key_change_in_production_9876543210
JWT_EXPIRES_IN=7d

# Business & Regional Configuration
TIMEZONE=Asia/Karachi
CURRENCY_CODE=PKR
ALLOW_NEGATIVE_STOCK=false

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
