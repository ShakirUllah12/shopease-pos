{
  "name": "shopease-pos",
  "version": "1.0.0",
  "description": "ShopEase POS — Retail Billing and Shop Management System",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "create-owner": "npm --prefix backend run create-owner",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "ShopEase POS Team",
  "license": "ISC"
}
